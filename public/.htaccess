# ============================================================================
#  Apache config for the static Next.js export (SiteGround)
# ============================================================================
#  The site is plain HTML/CSS/JS exported to public_html. Pages live at
#  <route>/index.html (trailingSlash), so Apache serves clean URLs natively.
#  contact.php is the only server-side script (contact form mail handler).
# ============================================================================

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Missing page -> exported 404 page.
  ErrorDocument 404 /404.html
</IfModule>
